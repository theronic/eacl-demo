{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.eacl.dev/schemas/static-deployment-status.v1.schema.json",
  "title": "EACL static deployment status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target", "outcome", "demoSha", "eaclSha", "artifactSha256", "deploymentId", "deployedAt", "objectVersions", "rollback"],
  "properties": {
    "schema": {"const": "eacl-demo.static-deployment-status.v1"},
    "target": {"const": "static"},
    "outcome": {"const": "succeeded"},
    "demoSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "eaclSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifactSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deploymentId": {"type": "string", "pattern": "^github:[1-9][0-9]*:[1-9][0-9]*:[0-9a-f]{16}$", "maxLength": 96},
    "deployedAt": {"type": "string", "format": "date-time"},
    "objectVersions": {"$ref": "#/$defs/publishedVersions"},
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectVersions"],
      "properties": {
        "objectVersions": {"$ref": "#/$defs/rollbackVersions"}
      }
    }
  },
  "$defs": {
    "versionId": {"type": "string", "minLength": 1, "maxLength": 1024},
    "publishedVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site-manifest.json", "datascript/index.html", "index.html"],
      "properties": {
        "site-manifest.json": {"$ref": "#/$defs/versionId"},
        "datascript/index.html": {"$ref": "#/$defs/versionId"},
        "index.html": {"$ref": "#/$defs/versionId"}
      }
    },
    "rollbackVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site-manifest.json", "datascript/index.html", "index.html", "registry/static.json"],
      "properties": {
        "site-manifest.json": {"$ref": "#/$defs/versionId"},
        "datascript/index.html": {"$ref": "#/$defs/versionId"},
        "index.html": {"$ref": "#/$defs/versionId"},
        "registry/static.json": {"$ref": "#/$defs/versionId"}
      }
    }
  }
}
