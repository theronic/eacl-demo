{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.eacl.dev/schemas/storage-benchmark-workload.v1.schema.json",
  "title": "Comparable Datahike storage benchmark workload",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "comparison", "runtime", "schedule", "lanes", "measurement", "analysis"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "id": {"const": "datahike-storage-million-v1"},
    "comparison": {"type": "object"},
    "runtime": {"type": "object"},
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "seed", "requestsPerWave", "operations"],
      "properties": {
        "algorithm": {"const": "weighted-block-sha256-sort-v1"},
        "seed": {"type": "string", "pattern": "^[0-9]+$"},
        "requestsPerWave": {"const": 100},
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "operation", "weightPer100", "method", "input"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "operation": {"enum": ["bootstrap", "list-subjects", "get-object", "list-relationships", "reverse-relationships", "check-permission", "get-schema", "count-objects"]},
              "weightPer100": {"type": "integer", "minimum": 1, "maximum": 100},
              "method": {"enum": ["GET", "POST"]},
              "input": {"type": "object"}
            }
          }
        }
      }
    },
    "lanes": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "measurement": {"type": "object"},
    "analysis": {"type": "object"}
  }
}
