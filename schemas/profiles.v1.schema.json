{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.eacl.dev/schemas/profiles.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "profiles"],
  "properties": {
    "$schema": {"const": "../../schemas/profiles.v1.schema.json"},
    "schema": {"const": "eacl-demo.profiles.v1"},
    "profiles": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "backend", "storage", "apiOrigin"],
        "properties": {
          "id": {"enum": ["datahike-s3", "datahike-dynamodb", "datomic-dynamodb", "datalevin-memory", "jank-memory", "datascript-browser-memory"]},
          "backend": {"enum": ["datahike", "datomic", "datalevin", "jank", "datascript"]},
          "storage": {"enum": ["s3", "dynamodb", "memory", "browser-memory"]},
          "apiOrigin": {
            "type": ["string", "null"],
            "pattern": "^https://[a-z0-9]+\\.lambda-url\\.[a-z0-9-]+\\.on\\.aws$"
          }
        }
      }
    }
  }
}
