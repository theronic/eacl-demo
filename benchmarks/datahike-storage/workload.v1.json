      {"id": "authorize-direct-deny", "operation": "authorize", "weightPer100": 8, "method": "POST", "input": {"subjectType": "user", "subjectId": "user-2", "resourceType": "account", "resourceId": "account-0", "permission": "admin", "consistency": "current"}},
      {"id": "authorize-arrow-relation", "operation": "authorize", "weightPer100": 8, "method": "POST", "input": {"subjectType": "user", "subjectId": "super-user", "resourceType": "server", "resourceId": "account-4-server-15", "permission": "view", "consistency": "current"}},
